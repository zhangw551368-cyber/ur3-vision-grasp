# Verified laboratory network and device defaults.
# Edit these values on another machine only when the physical lab configuration differs.
PC_IPV4_CIDR=192.168.1.41/24
LEFT_ARM_IP=192.168.1.43
RIGHT_ARM_IP=192.168.1.44
RIGHT_GRIPPER_DEVICE=/dev/serial/by-id/usb-FTDI_USB_TO_RS-485_DA6ACQ6P-if00-port0

# Components started by scripts/start_real_workcell.sh.
START_LEFT_ARM=true
START_RIGHT_ARM=true
START_CAMERA=true
START_HAND_EYE=true
START_MOVEIT=true
ALLOW_TRAJECTORY_EXECUTION=true
START_COLLISION_SCENE=true
START_RIGHT_GRIPPER=true
ACTIVATE_RIGHT_GRIPPER=true
START_GRIPPER_VISUALIZATION=true
START_RVIZ=true
ENABLE_POINTCLOUD=true
HEADLESS_MODE=false
MOVEIT_CONTROLLER_MANAGER=simple_right
