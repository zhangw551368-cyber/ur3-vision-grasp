<?xml version="1.0"?>
<launch>
  <!--
    Runtime-safe form of the 2026-08-17 eye-on-base calibration.

    Solved transform:
      right_arm_base -> camera_color_optical_frame
      xyz  = [-0.566325, 0.258012, -0.269924]
      xyzw = [-0.358932, 0.136223, -0.376358, 0.843188]

    The RealSense driver already publishes camera_link to the optical frames.
    This file therefore publishes the equivalent base-to-camera_link transform
    and keeps the driver's TF tree single-parented.
  -->
  <node pkg="tf2_ros"
        type="static_transform_publisher"
        name="right_arm_camera_eye_on_base_20260817_broadcaster"
        args="-0.556276094397 0.247522514856 -0.269264299368 0.123534986728 -0.363395366351 0.344525344370 0.856729363251 right_arm_base camera_link" />
</launch>
