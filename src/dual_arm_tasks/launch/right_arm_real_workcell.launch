<?xml version="1.0"?>
<launch>
  <!-- Hardware addresses can be overridden from the command line. -->
  <arg name="left_robot_ip" default="192.168.1.43"/>
  <arg name="right_robot_ip" default="192.168.1.44"/>
  <arg name="right_gripper_device" default="/dev/serial/by-id/usb-FTDI_USB_TO_RS-485_DA6ACQ6P-if00-port0"/>

  <!-- Components enabled by the portable one-command startup. -->
  <arg name="start_left_arm" default="true"/>
  <arg name="start_right_arm" default="true"/>
  <arg name="start_camera" default="true"/>
  <arg name="start_handeye" default="true"/>
  <arg name="start_moveit" default="true"/>
  <arg name="allow_trajectory_execution" default="true"/>
  <arg name="start_collision_scene" default="true"/>
  <arg name="start_right_gripper" default="true"/>
  <arg name="activate_right_gripper" default="true"/>
  <arg name="start_gripper_visualization" default="true"/>
  <arg name="start_rviz" default="true"/>
  <arg name="enable_pointcloud" default="true"/>
  <arg name="headless_mode" default="false"/>
  <arg name="moveit_controller_manager" default="simple_right"/>
  <arg name="environment_config" default="$(find dual_arm_tasks)/config/right_arm_real_environment_20260824.yaml"/>

  <!-- Start both physical UR3 drivers and publish the complete dual-arm model. -->
  <include file="$(find ur_robot_driver)/launch/ur3_dual_bringup.launch">
    <arg name="left_robot_ip" value="$(arg left_robot_ip)"/>
    <arg name="right_robot_ip" value="$(arg right_robot_ip)"/>
    <arg name="start_left_arm" value="$(arg start_left_arm)"/>
    <arg name="start_right_arm" value="$(arg start_right_arm)"/>
    <arg name="headless_mode" value="$(arg headless_mode)"/>
  </include>

  <!-- Supply fixed joint states when one physical arm is intentionally disabled. -->
  <group unless="$(arg start_left_arm)">
    <node pkg="dual_arm_tasks" type="static_joint_state_publisher.py" name="static_left_arm_joint_states" output="screen">
      <param name="prefix" value="left_arm_"/>
      <param name="joint_state_topic" value="/left_arm/joint_states"/>
    </node>
  </group>

  <group unless="$(arg start_right_arm)">
    <node pkg="dual_arm_tasks" type="static_joint_state_publisher.py" name="static_right_arm_joint_states" output="screen">
      <param name="prefix" value="right_arm_"/>
      <param name="joint_state_topic" value="/right_arm/joint_states"/>
    </node>
  </group>

  <!-- Publish aligned RGB-D from the fixed RealSense. -->
  <group if="$(arg start_camera)">
    <include file="$(find realsense2_camera)/launch/rs_camera.launch">
      <arg name="align_depth" value="true"/>
      <arg name="enable_sync" value="true"/>
      <arg name="enable_pointcloud" value="$(arg enable_pointcloud)"/>
      <arg name="pointcloud_texture_stream" value="RS2_STREAM_COLOR"/>
    </include>
  </group>

  <!-- Publish exactly one runtime-safe right-arm-base to camera-root transform. -->
  <group if="$(arg start_handeye)">
    <include file="$(find dual_arm_tasks)/launch/right_arm_camera_eye_on_base_20260817_safe.launch"/>
  </group>

  <!-- Start MoveIt with the verified right-arm trajectory controller. -->
  <group if="$(arg start_moveit)">
    <include file="$(find ur3_dual_moveit_config)/launch/move_group.launch">
      <arg name="allow_trajectory_execution" value="$(arg allow_trajectory_execution)"/>
      <arg name="moveit_controller_manager" value="$(arg moveit_controller_manager)"/>
    </include>
  </group>

  <!-- Apply the measured cabinet and corrected green-table collision geometry. -->
  <group if="$(arg start_collision_scene)">
    <include file="$(find dual_arm_tasks)/launch/right_arm_real_environment.launch">
      <arg name="config" value="$(arg environment_config)"/>
      <arg name="require_measured" value="true"/>
    </include>
  </group>

  <!-- Connect, activate and visualize the right Robotiq 2F gripper. -->
  <group if="$(arg start_right_gripper)">
    <node pkg="robotiq_2f_gripper_control"
          type="Robotiq2FGripperRtuNode_right.py"
          name="right_robotiq2FGripper"
          args="$(arg right_gripper_device)"
          output="screen"/>
  </group>

  <group if="$(arg activate_right_gripper)">
    <node pkg="dual_arm_tasks" type="activate_right_gripper.py" name="activate_right_gripper" output="screen">
      <param name="command_topic" value="/right_arm/Robotiq2FGripperRobotOutput"/>
      <param name="open_position" value="0"/>
      <param name="speed" value="120"/>
      <param name="force" value="80"/>
    </node>
  </group>

  <group if="$(arg start_gripper_visualization)">
    <node pkg="dual_arm_tasks" type="robotiq_2f_joint_state_visualizer.py" name="right_gripper_joint_state_visualizer" output="screen">
      <param name="prefix" value="right_"/>
      <param name="command_topic" value="/right_arm/Robotiq2FGripperRobotOutput"/>
      <param name="status_topic" value="/right_arm/Robotiq2FGripperRobotInput"/>
      <param name="preview_topic" value="/right_gripper/preview_command"/>
      <param name="joint_state_topic" value="/right_gripper/joint_states"/>
    </node>
  </group>

  <!-- Open RViz with the real robot and PlanningScene display. -->
  <group if="$(arg start_rviz)">
    <include file="$(find ur3_dual_moveit_config)/launch/moveit_rviz.launch">
      <arg name="rviz_config" value="$(find ur3_dual_moveit_config)/launch/moveit.rviz"/>
    </include>
  </group>
</launch>
