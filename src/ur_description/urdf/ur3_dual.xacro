<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg robot_model)_robot">

   <!-- import main macro -->
   <xacro:include filename="$(find ur_description)/urdf/inc/ur_macro.xacro"/>

   <!-- parameters -->
   <xacro:arg name="joint_limit_params" default="$(find ur_description)/config/ur3/joint_limits.yaml"/>
   <xacro:arg name="left_arm_kinematics_params" default="$(find ur_description)/config/ur3/default_kinematics.yaml"/>
   <xacro:arg name="right_arm_kinematics_params" default="$(find ur_description)/config/ur3/default_kinematics.yaml"/>
   <xacro:arg name="physical_params" default="$(find ur_description)/config/ur3/physical_parameters.yaml"/>
   <xacro:arg name="visual_params" default="$(find ur_description)/config/ur3/visual_parameters.yaml"/>
   <!-- legal values:
         - hardware_interface/PositionJointInterface
         - hardware_interface/VelocityJointInterface
         - hardware_interface/EffortJointInterface
   -->
   <xacro:arg name="transmission_hw_interface" default="hardware_interface/PositionJointInterface"/>
   <xacro:arg name="safety_limits" default="false"/>
   <xacro:arg name="safety_pos_margin" default="0.15"/>
   <xacro:arg name="safety_k_position" default="20"/>

   <link name="base">
     <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://ur_description/meshes/base.stl" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://ur_description/meshes/base.stl" />
      </geometry>
    </collision>
   </link>
   <joint name="base_left" type="fixed">
     <parent link="base" />
     <child link="left_arm_base_link" />
     <!--origin xyz="0 0.167071067811865 0.502928932188135" rpy="-2.52611294491941 -0.523598775598296 0.61547970867039" /-->
     <origin xyz="0 0.167071067811865 0.502928932188135" rpy="2.52611294491941 0.523598775598296 -2.52611294491941" />
   </joint>
   <joint name="base_right" type="fixed">
     <parent link="base" />
     <child link="right_arm_base_link" />
     <!--origin xyz="0 -0.167071067811865 0.502928932188135" rpy="-2.52611294491941 0.523598775598296 2.52611294491941" /-->
     <origin xyz="0 -0.167071067811865 0.502928932188135" rpy="2.52611294491941 -0.523598775598296 -0.615479708670389" />
   </joint>

   <!-- arm -->
   <xacro:ur_robot
     prefix="left_arm_"
     joint_limits_parameters_file="$(arg joint_limit_params)"
     kinematics_parameters_file="$(arg left_arm_kinematics_params)"
     physical_parameters_file="$(arg physical_params)"
     visual_parameters_file="$(arg visual_params)"
     transmission_hw_interface="$(arg transmission_hw_interface)"
     safety_limits="$(arg safety_limits)"
     safety_pos_margin="$(arg safety_pos_margin)"
     safety_k_position="$(arg safety_k_position)"/>

   <xacro:ur_robot
     prefix="right_arm_"
     joint_limits_parameters_file="$(arg joint_limit_params)"
     kinematics_parameters_file="$(arg right_arm_kinematics_params)"
     physical_parameters_file="$(arg physical_params)"
     visual_parameters_file="$(arg visual_params)"
     transmission_hw_interface="$(arg transmission_hw_interface)"
     safety_limits="$(arg safety_limits)"
     safety_pos_margin="$(arg safety_pos_margin)"
     safety_k_position="$(arg safety_k_position)"/>

   <xacro:include filename="$(find robotiq_2f_85_gripper_visualization)/urdf/robotiq_arg2f_85_model_macro.xacro" />
   <xacro:robotiq_arg2f_85 prefix="left_"/>
   <joint name="left_gripper" type="fixed">
     <parent link="left_arm_tool0" />
     <child link="left_robotiq_arg2f_base_link" />
     <origin xyz="0 0 0" rpy="0 0 0" />
   </joint>

   <xacro:include filename="$(find robotiq_2f_85_gripper_visualization)/urdf/robotiq_arg2f_85_model_macro.xacro" />
   <xacro:robotiq_arg2f_85 prefix="right_"/>
   <joint name="right_gripper" type="fixed">
     <parent link="right_arm_tool0" />
     <child link="right_robotiq_arg2f_base_link" />
     <origin xyz="0 0 0" rpy="0 0 0" />
   </joint>
</robot>
